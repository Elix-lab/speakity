# Copy to .env and fill in. Never commit .env.

PORT=3000
NODE_ENV=development

# Supabase → Project Settings → Database → Connection string.
# Use the pooler URL (port 6543, "Transaction" mode) for the app; prepared
# statements are off in src/db/index.ts so it works with the pooler.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# BetterAuth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of this backend (where /api/auth lives).
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated origins allowed by CORS and BetterAuth (Expo web, the app scheme…).
# Native apps don't send an Origin, so this only matters for web builds.
CORS_ORIGINS=http://localhost:8081,speakity://

# Not used yet: services/openai.ts is still stubbed.
OPENAI_API_KEY=

# Login providers — pending decision. Uncomment when Google is enabled.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
